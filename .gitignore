# Verilator specific
obj_dir/         # Default directory for Verilator output
*.dmp            # Waveform dumps
*.log            # Simulation logs
*.vcd            # Value Change Dump (for GTKWave)
*.fst            # Fast Signal Trace (for GTKWave)

# GTK and C/C++ Build Artifacts
*.o              # Object files
*.so             # Shared objects
*.a              # Static libraries
build/           # Common CMake/Make build folder
bin/             # Executable output folder
.flatpak-builder/# If using Flatpak for GTK apps

# Editor/System specific
.vscode/         # VS Code settings
.DS_Store        # macOS metadata
*~               # Backup files
